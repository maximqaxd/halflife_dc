/deploy/*
!/deploy/0winceos.bin
/obj
/gdi_out
/deploy_stage/

# IDE / build artifacts
*.plg
*.ncb
*.opt
*.pdb
*.obj
~$*.xlsx
__pycache__/
.claude/
/RE/*.disasm.txt

# eVC project editor scratch and local backups
/projects/zlib.old
/projects/~VCE*.tmp

# Deployment utilities and content-tool sources
/utils/*
!/utils/re/
!/utils/common/
!/utils/makels/
!/utils/qlumpy/
!/utils/studiomdl/
!/utils/build_tools.bat
!/utils/hltools.dsw
/utils/build/

# Keep only Python scripts from the RE utilities
/utils/re/**
!/utils/re/**/
!/utils/re/**/*.py
/utils/re/build/

# Local notes, diagnostics and symbol-port data
*.[mM][dD]
/crash.txt
/dbgeng_dump.obj
/portdata/
/utils/re/portdata/

# recoverable Ghidra project backups (not versioned)
/RE/halflife_dc_OLD.gpr
/RE/halflife_dc_OLD.rep/
*.prp.bak

# transient Ghidra session lock files
/RE/*.lock
/RE/*.lock~

# RE symbol export backups
*.tsv.bak

# Some other stuff
*.ps
*.prp
*.dat
