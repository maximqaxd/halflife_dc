/deploy/*
!/deploy/0winceos.bin
/obj
/gdi_out
/deploy_stage/

# IDE / build artifacts
*.plg
*.ncb
*.opt
*.pdb
~$*.xlsx
__pycache__/
.claude/
/RE/*.disasm.txt

# /utils holds deploy tooling (ignored) except the RE toolkit
/utils/*
!/utils/re/
/utils/re/build/

# large regenerable Ghidra instruction dump (ExportInsns.java)
/utils/re/bin_insns.tsv

# recoverable Ghidra project backups (not versioned)
/RE/halflife_dc_OLD.gpr
/RE/halflife_dc_OLD.rep/
*.prp.bak

# transient Ghidra session lock files
/RE/*.lock
/RE/*.lock~

# RE symbol export backups
*.tsv.bak
